load_package specfn2;


clear z;


% polynomial cases
p1 := hypergeometric({-6, 3, 2}, {-7, 1, 5}, z);


                         6                     5                    4
p1 := 0.000185185185185*z  + 0.00238095238095*z  + 0.0191326530612*z

                         3                   2
       + 0.108843537415*z  + 0.428571428571*z  + 1.02857142857*z + 1

p2 := hypergeometric({-6, 3}, {7, 1}, z);


                          6                     5                    4
p2 := 0.0000420875420875*z  - 0.00227272727273*z  + 0.0446428571429*z

                         3                  2
       - 0.396825396825*z  + 1.60714285714*z  - 2.57142857143*z + 1

p3 :=  hypergeometric({-6, -7, 2}, {-6, 1, 3}, z);


                             7                     6         5
p3 :=  - 0.0000440917107584*z  + 0.00243055555556*z  - 0.05*z

                         4                  3         2
       + 0.486111111111*z  - 2.33333333333*z  + 5.25*z  - 4.66666666667*z + 1

on rounded;


hypergeometric({-6, 3,2}, {-7, 1,5},5);


52.7544879063

p1 where z=>5;


52.7544879063


hypergeometric({-6, 3}, {7, 1},-3);


38.0918831169

p2 where z=> -3;


38.0918831169


hypergeometric({-6, -7, 2}, {-6, 1, 3}, 1.1);


-0.251090267062

p3 where z => 1.1;


-0.251090267062


% elementary functions
foreach z in {1/3.0, 2/3.0, -2/3.0, 0.9}
   collect (hypergeometric({1,1},{2},z) +log(1-z)/z);


{-2.0605739337e-13,-1.29141142224e-12,-2.44249065418e-13,-8.05400190984e-12}


foreach z in {1/3.0, 2/3.0, -2/3.0, 0.9}
   collect (hypergeometric({0.5,0.5},{1.5},z^2)-asin z/z);


{0,-4.45865566689e-13,-4.45865566689e-13,-8.17124146124e-14}


foreach z in {1/3.0, 2/3.0, -2/3.0, 0.9}
   collect (hypergeometric({0.5,1},{1.5},-z^2) -atan z/z);


{0,1.32338584535e-13,1.32338584535e-13,-4.03233002544e-13}


a:= 3$


b:= 2$


foreach z in {1/3.0, 2/3.0, -2/3.0, 0.9}
   collect (hypergeometric({a,b},{a},z) -1/(1-z)^b);


{-2.30926389122e-13,-2.01794136956e-12,-3.95239396767e-13,-8.64019966684e-12}


foreach z in {1/3.0, 2/3.0, -2/3.0, 0.9}
   collect (hypergeometric({a,b},{b},z) -1/(1-z)^a);


{-4.54747350886e-13,-1.90425453184e-12,-3.47499806708e-13,0}

      
a:= 3$


b:= 6$


foreach z in {1/3.0, 2/3.0, -2/3.0, 0.9}
   collect (hypergeometric({a,b},{a},z) -1/(1-z)^b);


{0,0,2.42639242032e-13,0}


foreach z in {1/3.0, 2/3.0, -2/3.0, 0.9}
   collect (hypergeometric({a,b},{b},z) -1/(1-z)^a);


{-4.54747350886e-13,-1.90425453184e-12,-3.47499806708e-13,0}


