% the next 2 succeed if precision is increased to 24
% and agree with Maple
precision 24;


12

hypergeometric({0.5, 0.7},{2},0.6+0.8i);


1.03752140440666718647076 + 0.194797325821030269574051*i
  % severe rounding at precision 12
hypergeometric({0.5i, 0.7i},{2},0.6+0.8i);


0.931068569129139204198025 - 0.134745981762060425616127*i
  % fails at precision 12
% hypergeometric({0.5, 0.7},{1.5},exp(i*pi/3)); % still fails
% hypergeometric({0.5+i, 0.7-i},{1.9},exp(i*pi/3)); % still fails
precision 12;


24

hypergeometric({0.5, 0.7},{5.5},exp(i*pi/3));


1.0217360916 + 0.0643272186106*i
   % OK
hypergeometric({0.5+i, 0.7-i},{5.9},exp(i*pi/3));


1.0280338931 + 0.246819968981*i
   % OK

