load_package specfn2;


clear z;


off complex,rounded;


*** Domain mode complex-rounded changed to rounded 

% polynomial cases
p1 := hypergeometric({-6, 3, 2}, {-7, 1, 5}, z);


           6         5          4          3           2
       98*z  + 1260*z  + 10125*z  + 57600*z  + 226800*z  + 544320*z + 529200
p1 := -----------------------------------------------------------------------
                                      529200

p2 := hypergeometric({-6, 3}, {7, 1}, z);


          6        5         4          3           2
       7*z  - 378*z  + 7425*z  - 66000*z  + 267300*z  - 427680*z + 166320
p2 := --------------------------------------------------------------------
                                     166320

p3 :=  hypergeometric({-6, -7, 2}, {-6, 1, 3}, z);


             7        6         5          4           3           2
p3 := ( - 8*z  + 441*z  - 9072*z  + 88200*z  - 423360*z  + 952560*z  - 846720*z

        + 181440)/181440

on rounded,complex;


*** Domain mode rounded changed to complex-rounded 

hypergeometric({-6, 3,2}, {-7, 1,5},5+i);


43.2589795918 + 32.4148148148*i

p1 where z=>5+i;


43.2589795918 + 32.4148148148*i


hypergeometric({-6, 3}, {7, 1},-3+2i);


6.42360509861 - 48.2821067821*i

p2 where z=> -3+2i;


6.42360509861 - 48.2821067821*i


hypergeometric({-6, -7, 2}, {-6, 1, 3}, 1.1i);


 - 4.64509059965 - 2.1081062444*i

p3 where z => 1.1i;


 - 4.64509059965 - 2.1081062444*i


% elementary functions
(hypergeometric({0.5,0.5},{1.5},z^2)-asin z/z) where z=>0.6i;


1.14575016141e-13


(hypergeometric({0.5,1},{1.5},-z^2) -atan z/z) where z=>0.5+0.5i;


 - 1.61648472385e-13 - 3.31290550548e-13*i


(hypergeometric({1,1},{2},z) +log(1-z)/z )where z=> -0.3i;


1.26121335597e-13 - 3.8635761257e-14*i


% Miscellaneous examples compared with Maple results.
% 2F1
tmp := hypergeometric({0.5, 0.7},{1.5},1.3);


tmp := 2.01617332442 - 0.798657608015*i
   % real part differs from Maple
% but is consistent with nearby results below
hypergeometric({0.5, 0.7},{1.5},1.3+0.0000001i);


2.01617328286 + 0.798657677683*i

hypergeometric({0.5, 0.7},{1.5},1.3-0.0000001i);


2.01617328286 - 0.798657677683*i

hyper_discont(0.5,0.7,1.5,1.3)+tmp;


2.01617332442 + 0.798657608016*i

% value on upper edge of the cut
tmp := hypergeometric({0.5, 0.7},{1.5},2.8);


tmp := 0.750920536712 - 0.839564938534*i
  
hypergeometric({0.5, 0.7},{1.5},2.8+0.0000001i);


0.75092054213 + 0.83956491817*i

hypergeometric({0.5, 0.7},{1.5},2.8-0.0000001i);


0.75092054213 - 0.83956491817*i

hyper_discont(0.5,0.7,1.5,2.8)+tmp;


0.750920536712 + 0.839564938534*i

