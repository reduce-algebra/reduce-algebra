on time;


Time: 0 ms


% Exact polynomial values for a,b positive integers:

for a := 1:5 do for b := 1:5 do write ibeta(a,b,x) := ibeta(a,b,x);


ibeta(1,1,x) := x

ibeta(1,2,x) := x*( - x + 2)

                    2
ibeta(1,3,x) := x*(x  - 3*x + 3)

                       3      2
ibeta(1,4,x) := x*( - x  + 4*x  - 6*x + 4)

                    4      3       2
ibeta(1,5,x) := x*(x  - 5*x  + 10*x  - 10*x + 5)

                 2
ibeta(2,1,x) := x

                 2
ibeta(2,2,x) := x *( - 2*x + 3)

                 2     2
ibeta(2,3,x) := x *(3*x  - 8*x + 6)

                 2        3       2
ibeta(2,4,x) := x *( - 4*x  + 15*x  - 20*x + 10)

                 2     4       3       2
ibeta(2,5,x) := x *(5*x  - 24*x  + 45*x  - 40*x + 15)

                 3
ibeta(3,1,x) := x

                 3
ibeta(3,2,x) := x *( - 3*x + 4)

                 3     2
ibeta(3,3,x) := x *(6*x  - 15*x + 10)

                 3         3       2
ibeta(3,4,x) := x *( - 10*x  + 36*x  - 45*x + 20)

                 3      4       3        2
ibeta(3,5,x) := x *(15*x  - 70*x  + 126*x  - 105*x + 35)

                 4
ibeta(4,1,x) := x

                 4
ibeta(4,2,x) := x *( - 4*x + 5)

                 4      2
ibeta(4,3,x) := x *(10*x  - 24*x + 15)

                 4         3       2
ibeta(4,4,x) := x *( - 20*x  + 70*x  - 84*x + 35)

                 4      4        3        2
ibeta(4,5,x) := x *(35*x  - 160*x  + 280*x  - 224*x + 70)

                 5
ibeta(5,1,x) := x

                 5
ibeta(5,2,x) := x *( - 5*x + 6)

                 5      2
ibeta(5,3,x) := x *(15*x  - 35*x + 21)

                 5         3        2
ibeta(5,4,x) := x *( - 35*x  + 120*x  - 140*x + 56)

                 5      4        3        2
ibeta(5,5,x) := x *(70*x  - 315*x  + 540*x  - 420*x + 126)

Time: 15 ms




% All numerical results agree to 12 digits with Mathematica using
% https://functions.wolfram.com/GammaBetaErf/BetaRegularized/ except
% that Mathematica gives ibeta(0.5, 0.5, 0.99999999) = 0.999936338022
% which differs by 1 in the last decimal place.

% In Mathematica, the domain appears to be the whole complex plane!

on rounded;


Time: 0 ms


a := 0.5$


Time: 0 ms

b := 0.5$


Time: 0 ms


for i := 0 : 10 do write ibeta(a, b, 0.1*i) := ibeta(a, b, 0.1*i);


